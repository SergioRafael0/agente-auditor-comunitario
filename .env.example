# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
# Modelo y tope de tokens por rol (opcional: por defecto usa GROQ_MODEL)
# El planificador usa una version ligera: solo decide el tipo de tarea y el plan
GROQ_MODEL_PLANIFICADOR=openai/gpt-oss-20b
# GROQ_MAX_TOKENS_AUDITOR=900
# Reintentos con backoff ante rate limit (429) antes de degradar a modo demo
LLM_REINTENTOS=2
LLM_BACKOFF_S=20
# offline = modo demo sin API key (respuestas simuladas, ver README)
# LLM_MODO=offline

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chroma
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=normativa_comunidades

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/interacciones.jsonl
LOG_FILE_AGENTE=data/agente_ejecuciones.jsonl
# Observabilidad (EV3)
LOG_FILE_EVENTOS=data/eventos.jsonl
LOG_FILE_ACCESOS=data/accesos.jsonl
# Anonimizar datos personales (correos, RUT, telefonos) en los logs: 1=si, 0=no
LOG_ANONIMIZAR=1
# Umbral de confianza del retrieval: fragmentos con score bajo se descartan
SCORE_MINIMO=0.35

# MCP server
MCP_AUTH_TOKEN=cambia-este-token-por-algo-seguro
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Limite de peticiones por IP por minuto y tamano maximo del texto auditado
RATE_LIMIT_PER_MIN=60
MAX_TEXTO_LEN=5000

# Memoria
# Corto plazo: ruta del checkpoint sqlite (vacio = MemorySaver en RAM)
MEMORIA_CHECKPOINT=data/memoria/checkpoints.sqlite
# Largo plazo: coleccion Chroma de experiencias auditadas
MEMORIA_COLECCION=experiencias_auditoria
