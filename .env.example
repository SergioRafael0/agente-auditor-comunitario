# Groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# MCP server
MCP_AUTH_TOKEN=cambia-este-token-por-algo-seguro
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Chroma
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=normativa_comunidades

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/interacciones.jsonl
LOG_FILE_AGENTE=data/agente_ejecuciones.jsonl

# Memoria
# Corto plazo: ruta del checkpoint sqlite (vacio = MemorySaver en RAM)
MEMORIA_CHECKPOINT=data/memoria/checkpoints.sqlite
# Largo plazo: coleccion Chroma de experiencias auditadas
MEMORIA_COLECCION=experiencias_auditoria
